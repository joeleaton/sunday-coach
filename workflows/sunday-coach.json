      "id": "86e92834-0ebd-46ae-a9b2-079070fe3080",
      "name": "Get next week's plan",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        672,
        112
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseOAuth2Api": {
          "name": "Supabase account"
        }
      }
