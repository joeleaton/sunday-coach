    {
      "parameters": {
        "promptType": "define",
        "text": "=Here is my training summary for the week:\n\n{{ JSON.stringify($json.summary, null, 2) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are an experienced marathon coach. The athlete is targeting 2:40 at the London Marathon in April 2027. Review the past week against the plan and the training load. Write a short, direct review for a 60-second voice note: what went well, one thing to watch, and one specific change for next week. Use miles and pace per mile. No more than 150 words. Be honest and practical. If form is below {{ $json.form_threshold }}, choose the hardest session next week to ease.\n\nUse the \"Look up activity\" tool if you need to check an unusual session in detail (pass its id).\nReturn \"review\" (the voice-note text) and \"ease_session_id\" (the id from next_week_sessions of the session to ease, or null if no session needs easing)."
        }
      },
      "id": "b296833b-4038-420c-90d2-4a75c93ea936",
