    {
      "parameters": {
        "jsCode": "// ---- Settings ----\nconst FORM_THRESHOLD = -20;           // ease next week if form is below this\nconst MARATHON_PACE_SEC = 6 * 60 + 6; // 6:06 per mile = 2:40 marathon pace\n\nconst clean = (items) => items.map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst activities = clean($('Get week from JAVA').all());\nconst load = clean($('Get training load').all())[0] || {};\nconst plan = clean($(\"Get next week's plan\").all());\n\nconst round1 = (n) => Math.round((Number(n) || 0) * 10) / 10;\nconst toPace = (sec) => {\n  if (!sec || !isFinite(sec)) return null;\n  const m = Math.floor(sec / 60);\n  const s = Math.round(sec % 60);\n  return m + ':' + String(s).padStart(2, '0');\n};\n\n// This week's activities from JAVA (distance_m in metres, moving_s in seconds); skip deleted ones\nconst sessions = activities.filter(a => !a.deleted_at).map(a => {\n  const miles = (Number(a.distance_m) || 0) / 1609.344;\n  const secs = Number(a.moving_s) || 0;\n  const paceSec = miles > 0 ? secs / miles : null;\n  return {\n    id: a.id,\n    date: String(a.start_time || '').slice(0, 10),\n    type: a.sport,\n    name: a.name,\n    miles: round1(miles),\n    moving_time_min: Math.round(secs / 60),\n    avg_pace_per_mile: toPace(paceSec),\n    avg_hr: a.avg_hr ?? null,\n    _paceSec: paceSec,\n  };\n});\nconst runs = sessions.filter(s => String(s.type || '').toLowerCase().includes('run'));\nconst totalMiles = runs.reduce((sum, r) => sum + r.miles, 0);\nconst longest = runs.reduce((best, r) => (r.miles > (best ? best.miles : 0) ? r : best), null);\nconst mpMiles = runs.filter(r => r._paceSec && r._paceSec <= MARATHON_PACE_SEC).reduce((sum, r) => sum + r.miles, 0);\n\n// Split the plan into this week (for actual vs planned) and next week\nconst nextMonday = $now.startOf('week').plus({ weeks: 1 }).toISODate();\nconst pastPlan = plan.filter(p => String(p.date).slice(0, 10) < nextMonday);\nconst nextWeek = plan\n  .filter(p => String(p.date).slice(0, 10) >= nextMonday)\n  .map(p => ({ id: p.id, date: String(p.date).slice(0, 10), workout_type: p.workout_type, name: p.name, planned_miles: p.distance != null ? Number(p.distance) : null, description: p.description || '' }));\nconst plannedMiles = pastPlan.reduce((sum, p) => sum + (Number(p.distance) || 0), 0);\n\nconst fitness = Number(load.fitness);\nconst fatigue = Number(load.fatigue);\nconst form = load.form != null ? Number(load.form) : fitness - fatigue;\n\nreturn [{\n  json: {\n    form_threshold: FORM_THRESHOLD,\n    summary: {\n      goal: 'London Marathon April 2027, 2:40 (6:06/mile)',\n      total_run_miles: round1(totalMiles),\n      number_of_runs: runs.length,\n      longest_run: longest ? { id: longest.id, date: longest.date, miles: longest.miles, avg_pace_per_mile: longest.avg_pace_per_mile } : null,\n      miles_at_or_faster_than_marathon_pace: round1(mpMiles),\n      actual_vs_planned_miles: { actual: round1(totalMiles), planned: round1(plannedMiles), difference: round1(totalMiles - plannedMiles) },\n      training_load: { fitness: round1(fitness), fatigue: round1(fatigue), form: round1(form) },\n      this_week_activities: sessions.map(({ _paceSec, ...rest }) => rest),\n      next_week_sessions: nextWeek,\n    },\n  },\n}];"
      },
      "id": "d08ae946-db8b-46f2-837a-6b5fa3e0a5f6",
      "name": "Crunch the numbers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
